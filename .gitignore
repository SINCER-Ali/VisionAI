# ---------------------- Rust ----------------------
# Dossier de compilation, regenere par `cargo build` -> ne JAMAIS versionner
target/
# (Cargo.lock est garde : il fige les versions des dependances)

# ---------------------- Python ----------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Environnements virtuels
.venv/
venv/
env/
ENV/

# ---------------------- Jupyter ----------------------
.ipynb_checkpoints/

# ---------------------- IDE / editeurs ----------------------
.idea/
.vscode/
*.iml

# ---------------------- Systeme ----------------------
.DS_Store
Thumbs.db

# ---------------------- Claude Code (config locale perso) ----------------------
.claude/settings.local.json

# ---------------------- Modeles entraines (lourds) ----------------------
# Regeneres par les scripts python/train_*.py -> on ne les versionne pas.
models/*.json
models/*.bin
models/*.model

# ---------------------- Donnees : images brutes (lourdes, sur Drive) ----------------------
datasets/train/
# (les .npy restent versionnes : ils sont produits par preprocessing.py et
#  utilises par les scripts train_*.py ; decommente si trop lourd)
# datasets/*.npy